// Schema del MVP - Modulo Distribucion BASF + Planning
// Actualizado: administracion de perfiles (nivel de acceso + permisos por modulo)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Rol funcional: a que "area" de trabajo pertenece el usuario (se mantiene igual que antes)
enum RolFuncional {
  PLANIFICADOR
  RENDICION
}

// Nivel de acceso: separado del rol funcional.
// ADMIN: control total + administra usuarios. Ignora la tabla de permisos por modulo.
// USUARIO: su acceso a cada modulo depende de PermisoModulo.
enum NivelAcceso {
  ADMIN
  USUARIO
}

// Modulos de la app que se pueden restringir individualmente
enum Modulo {
  DISPONIBILIDAD
  VIAJES
  PLANNING
  RENDICIONES
  CIERRE_FACTURACION
}

// Nivel de permiso que un Usuario (no admin) tiene sobre un modulo puntual
enum NivelPermiso {
  SIN_ACCESO
  LECTURA
  ESCRITURA
}

enum EstadoDisponibilidad {
  DISPONIBLE
  OFRECIDA
  ASIGNADA
}

enum EstadoViaje {
  PRECARGA
  ASIGNADO
  INICIADO
  FINALIZADO
  RENDIDO
}

enum StatusRendicion {
  PENDIENTE
  RENDIDO_SIN_OK
  RENDIDO_CON_ADICIONAL
  OK_FACTURAR
}

model Usuario {
  id            String       @id @default(uuid())
  nombre        String
  email         String       @unique
  passwordHash  String
  rolFuncional  RolFuncional @default(PLANIFICADOR)
  nivelAcceso   NivelAcceso  @default(USUARIO)
  activo        Boolean      @default(true)
  createdAt     DateTime     @default(now())

  // Quien creo este usuario (trazabilidad: solo un ADMIN puede crear usuarios)
  creadoPorId   String?
  creadoPor     Usuario?     @relation("CreadoPor", fields: [creadoPorId], references: [id])
  usuariosCreados Usuario[]  @relation("CreadoPor")

  permisos        PermisoModulo[]
  viajesAsignados Viaje[]         @relation("AsignadoPor")
}

// Permiso puntual de un Usuario (nivelAcceso = USUARIO) sobre un modulo.
// Si no existe fila para un modulo, se interpreta como SIN_ACCESO.
model PermisoModulo {
  id        String       @id @default(uuid())
  usuarioId String
  usuario   Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  modulo    Modulo
  nivel     NivelPermiso @default(SIN_ACCESO)

  @@unique([usuarioId, modulo])
}

model Planta {
  id     String @id @default(uuid())
  nombre String @unique
  codigo String @unique

  disponibilidades Disponibilidad[]
  viajes           Viaje[]
  codigosRendicion CodigoRendicion[]
}

model Chofer {
  id       String  @id @default(uuid())
  nombre   String
  licencia String?
  telefono String?
  activo   Boolean @default(true)

  disponibilidades Disponibilidad[]
  viajes           Viaje[]
}

model Unidad {
  id      String  @id @default(uuid())
  patente String  @unique
  tipo    String
  activa  Boolean @default(true)

  disponibilidades Disponibilidad[]
  viajes           Viaje[]
}

model Disponibilidad {
  id       String               @id @default(uuid())
  fecha    DateTime
  plantaId String
  planta   Planta               @relation(fields: [plantaId], references: [id])
  unidadId String
  unidad   Unidad               @relation(fields: [unidadId], references: [id])
  choferId String
  chofer   Chofer               @relation(fields: [choferId], references: [id])
  horario  String
  estado   EstadoDisponibilidad @default(DISPONIBLE)
}

model Viaje {
  id            String      @id @default(uuid())
  fecha         DateTime
  plantaId      String
  planta        Planta      @relation(fields: [plantaId], references: [id])
  unidadId      String?
  unidad        Unidad?     @relation(fields: [unidadId], references: [id])
  choferId      String?
  chofer        Chofer?     @relation(fields: [choferId], references: [id])
  citacion      String?
  numeroViaje   String?
  estado        EstadoViaje @default(PRECARGA)
  asignadoPorId String?
  asignadoPor   Usuario?    @relation("AsignadoPor", fields: [asignadoPorId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
 
  rendicion Rendicion?
}

model Rendicion {
  id                  String          @id @default(uuid())
  viajeId             String          @unique
  viaje               Viaje           @relation(fields: [viajeId], references: [id])
  nroRemitos          String
  clienteFacturar     String
  codigoTarifa        String
  cantidadDestinos    Int
  ultimaFechaEntrega  DateTime
  codigoLocalidad     String
  pdfUrl              String?
  adicional           Boolean         @default(false)
  status              StatusRendicion @default(PENDIENTE)
  observaciones       String?
  codigoRendicionId   String?
  codigoRendicion     CodigoRendicion? @relation(fields: [codigoRendicionId], references: [id])
  createdAt           DateTime        @default(now())
}

model CodigoRendicion {
  id            String      @id @default(uuid())
  codigo        String
  plantaId      String
  planta        Planta      @relation(fields: [plantaId], references: [id])
  fechaEnvioAga DateTime?
  createdAt     DateTime    @default(now())
  rendiciones   Rendicion[]
}
