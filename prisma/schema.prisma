// Schema del MVP - Modulo Distribucion BASF + Planning
// Basado en el proceso actual (Excel/Sheets) relevado en la presentacion del cliente.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  PLANIFICADOR
  RENDICION
}

enum EstadoDisponibilidad {
  DISPONIBLE
  OFRECIDA
  ASIGNADA
}

enum EstadoViaje {
  PRECARGA
  ASIGNADO
  INICIADO
  FINALIZADO
  RENDIDO
}

enum StatusRendicion {
  PENDIENTE
  RENDIDO_SIN_OK
  RENDIDO_CON_ADICIONAL
  OK_FACTURAR
}

model Usuario {
  id            String   @id @default(uuid())
  nombre        String
  email         String   @unique
  passwordHash  String
  rol           Rol      @default(PLANIFICADOR)
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())

  viajesAsignados Viaje[] @relation("AsignadoPor")
}

model Planta {
  id     String @id @default(uuid())
  nombre String @unique
  codigo String @unique

  disponibilidades  Disponibilidad[]
  viajes            Viaje[]
  codigosRendicion  CodigoRendicion[]
}

model Chofer {
  id        String   @id @default(uuid())
  nombre    String
  licencia  String?
  telefono  String?
  activo    Boolean  @default(true)

  disponibilidades Disponibilidad[]
  viajes           Viaje[]
}

model Unidad {
  id        String   @id @default(uuid())
  patente   String   @unique
  tipo      String
  activa    Boolean  @default(true)

  disponibilidades Disponibilidad[]
  viajes           Viaje[]
}

// Disponibilidad diaria que se ofrece al cliente antes de las 10hs
model Disponibilidad {
  id        String                @id @default(uuid())
  fecha     DateTime
  plantaId  String
  planta    Planta                @relation(fields: [plantaId], references: [id])
  unidadId  String
  unidad    Unidad                @relation(fields: [unidadId], references: [id])
  choferId  String
  chofer    Chofer                @relation(fields: [choferId], references: [id])
  horario   String
  estado    EstadoDisponibilidad  @default(DISPONIBLE)
  createdAt DateTime              @default(now())

  @@index([fecha, plantaId])
}

// Viaje: nace de la respuesta del cliente (import/carga manual), se asigna chofer/unidad,
// y al finalizar dispara la rendicion.
model Viaje {
  id            String      @id @default(uuid())
  fecha         DateTime
  plantaId      String
  planta        Planta      @relation(fields: [plantaId], references: [id])
  unidadId      String?
  unidad        Unidad?     @relation(fields: [unidadId], references: [id])
  choferId      String?
  chofer        Chofer?     @relation(fields: [choferId], references: [id])
  citacion      String?
  numeroViaje   String?     @unique
  estado        EstadoViaje @default(PRECARGA)
  asignadoPorId String?
  asignadoPor   Usuario?    @relation("AsignadoPor", fields: [asignadoPorId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  rendicion     Rendicion?

  @@index([fecha, plantaId, estado])
}

model Rendicion {
  id                  String          @id @default(uuid())
  viajeId             String          @unique
  viaje               Viaje           @relation(fields: [viajeId], references: [id])
  nroRemitos          String
  clienteFacturar     String
  codigoTarifa        String
  cantidadDestinos    Int
  ultimaFechaEntrega  DateTime
  codigoLocalidad     String
  pdfUrl              String?
  adicional           Boolean         @default(false)
  status              StatusRendicion @default(PENDIENTE)
  observaciones       String?
  codigoRendicionId   String?
  codigoRendicion     CodigoRendicion? @relation(fields: [codigoRendicionId], references: [id])
  createdAt           DateTime        @default(now())
}

// Rotulo que agrupa entre 10 y 20 HR rendidas, por planta, para el envio semanal a AGA
model CodigoRendicion {
  id              String      @id @default(uuid())
  codigo          String      @unique
  plantaId        String
  planta          Planta      @relation(fields: [plantaId], references: [id])
  fechaEnvioAga   DateTime?
  createdAt       DateTime    @default(now())

  rendiciones     Rendicion[]
}
